{
  "name": "@roxybrowser/openapi",
  "version": "3.0.0",
  "description": "MCP server for RoxyBrowser automation - manage browser instances and get CDP endpoints",
  "keywords": [
    "browser-automation",
    "cdp",
    "chrome-devtools-protocol",
    "mcp",
    "model-context-protocol",
    "roxybrowser"
  ],
  "license": "MIT",
  "author": "RoxyBrowser",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roxybrowserlabs/roxybrowser-mcp-server.git"
  },
  "bin": {
    "roxybrowser-mcp": "lib/cli/browser.js",
    "roxybrowser-openapi-mcp": "lib/cli/browser.js",
    "roxycommerce-mcp": "lib/cli/commerce.js"
  },
  "files": [
    "lib",
    "skills",
    "package.json"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      },
      "default": "./lib/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack",
    "start": "node lib/cli/browser.js",
    "dev": "vp pack --watch",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "inspect": "pnpm build && mcp-inspector --web --config mcp.inspector.json",
    "inspect:tui": "pnpm build && mcp-inspector --tui --config mcp.inspector.json",
    "inspect:cli:browser": "pnpm build && mcp-inspector --cli --config mcp.inspector.json --server roxybrowser --method tools/list",
    "inspect:cli:commerce": "pnpm build && mcp-inspector --cli --config mcp.inspector.json --server roxycommerce --method tools/list",
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "skills:apply": "node support/sync-skills-metadata.mjs apply",
    "skills:check": "node support/sync-skills-metadata.mjs check",
    "skills:pull": "node support/sync-skills-metadata.mjs pull",
    "publish:release": "pnpm clean && pnpm version patch --no-git-tag-version && pnpm build && pnpm publish",
    "publish:beta": "pnpm version prerelease --preid=beta --no-git-tag-version && pnpm build && pnpm publish --tag beta"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@modelcontextprotocol/inspector": "2.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "@voidzero-dev/vite-plus-core": "^0.2.6",
    "publint": "^0.3.22",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.18.0 || >=24.11.0"
  },
  "packageManager": "pnpm@11.18.0"
}
